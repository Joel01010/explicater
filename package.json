{
  "name": "scholium",
  "version": "1.0.0",
  "description": "Obsidian plugin: right-click selected text to explain it with DeepSeek/ChatGPT/Claude/Gemini/Grok/Perplexity in the built-in browser, via Playwright over CDP.",
  "scripts": {
    "build": "node patch.mjs && node build.mjs",
    "test": "node test/selfcheck.mjs && node test/prompt.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "deepseek",
    "playwright",
    "cdp"
  ],
  "author": "Joel01010",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2"
  }
}