{
  "name": "explicater",
  "version": "1.0.0",
  "description": "Obsidian plugin: right-click selected text to explain it with your web AI chat (DeepSeek, ChatGPT, Claude, Gemini, Grok, Perplexity) in the built-in browser, via Playwright over CDP.",
  "scripts": {
    "build": "node patch.mjs && node build.mjs",
    "test": "node test/selfcheck.mjs && node test/prompt.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "playwright",
    "cdp"
  ],
  "author": "Joel01010",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.14.4",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}